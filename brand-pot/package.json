{
  "name": "slaply-brand-pot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview:worker": "wrangler dev --config wrangler.jsonc --port 8788",
    "deploy:preview": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:production": "npm run build && wrangler deploy --config wrangler.jsonc --env production"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "^6.4.5",
    "wrangler": "^4.90.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
