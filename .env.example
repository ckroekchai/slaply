# Brand Pot backend secrets belong in brand-pot/.dev.vars for local development,
# and Cloudflare encrypted Worker secrets for deployed environments.
# Never use VITE_ or NEXT_PUBLIC_ for private keys.
OPENAI_API_KEY=
OPENAI_BRAND_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
DAILY_SESSION_LIMIT=5
DAILY_IP_LIMIT=10
DAILY_GLOBAL_LIMIT=40
